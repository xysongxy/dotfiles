  "Slide Template 1": {
    "scope": "tex,latex,plaintex",
    "prefix": "ts1",
    "body": [
      "%!TEX program = pdflatex",
      "",
      "\\documentclass[10pt, handout]{beamer}",
      "\\usepackage{talk}",
      "",
      "\\title[]{${1:Title}}",
      "\\author[${2:Song}]{${3:Xiangyu Song}}",
      "\\institute{${4:Washington University in St. Louis}}",
      "\\date{${5:\\\\today}}",
      "",
      "\\begin{document}",
      "",
      "\\maketitle",
      "",
      "${0:% Add your content here}",
      "",
      "\\end{document}"
    ],
    "description": "Slide Template 1"
  },
  "Slide Template 2": {
    "scope": "tex,latex,plaintex",
    "prefix": "ts2",
    "body": [
      "%!TEX program = xelatex",
      "",
      "\\documentclass[10pt]{beamer}",
      "\\usepackage{discussion}",
      "",
      "\\title[]{${1:Title}}",
      "\\author[${2:Song}]{${3:Xiangyu Song}}",
      "\\institute{${4:Washington University in St. Louis}}",
      "\\date{${5:\\\\today}}",
      "",
      "\\begin{document}",
      "",
      "\\maketitle",
      "",
      "${0:% Add your content here}",
      "",
      "\\end{document}"
    ],
    "description": "Slide Template 2"
  },
  "Paper Template": {
    "scope": "tex,latex,plaintex",
    "prefix": "tp",
    "body": [
      "%!TEX program = pdflatex",
      "",
      "\\documentclass[11pt]{article}",
