  "Assignment Template": {
    "scope": "tex,latex,plaintex",
    "prefix": "ta",
    "body": [
      "%!TEX program = xelatex",
      "",
      "\\documentclass[11pt]{article}",
      "\\usepackage[assignment]{note}",
