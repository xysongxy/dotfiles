{
	"dollar math": {
		"prefix": "mm",
		"body": ["\\$$1\\$"]
	},

	"R Sweave Chunk": {
    "prefix": "rc",
    "body": [
      "<<$1, echo=$2, results=$3>>=",
      "  $0",
      "@"
    ],
    "description": "Insert R Sweave Chunk"
	},


	"Rnw Note or Assignment Template": {
		"prefix": ["docsetup", "trnw"],
		"body": [
			"\\documentclass[11pt]{article}",
			"\\usepackage[${1|notes,assignment|}]{note}",
			"",
			"\\renewcommand{\\coursename}{${2:Course Name}}",
			"\\renewcommand{\\instructorname}{${3:Instructor Name}}",
			"",
			"\\title{${4:Title}}",
			"\\author{${5:Xiangyu Song}}",
			"\\date{${6:\\today}}",
			"",
			"\\begin{document}",
			"",
			"\\maketitle",
			"",
			"<<setup, include=FALSE>>=",
			"knitr::opts_chunk\\$set(",
			"  echo = TRUE,",
			"  message = FALSE,",
			"  warning = FALSE,",
			"  fig.align = 'center',",
			"  fig.width = 7,",
			"  fig.height = 4.5",
			")",
			"@",
			"",
			"${0:% Add your content here}",
			"",
			"\\end{document}"
		],
		"description": "Rnw template using the note package in notes or assignment mode"
	},


	"Include Graphics": {
		"prefix": "includegraphics",
		"body": [
		"\\begin{figure}[h]",
		"  \\centering",
		"  \\includegraphics[width=0.8\\textwidth]{$1}",
		"  \\caption{$2}",
		"  \\label{fig:$3}",
		"\\end{figure}"
		],
		"description": "Insert include graphics environment"
	},
	"Inline R Code": {
		"prefix": "rin",
		"body": [
			"\\Sexpr{$1}"
		],
		"description": "Insert inline R code"
	}
}
